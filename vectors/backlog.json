  "body": {
    "background": "Refunds are rounded per line, invoices on the total, so a refund can differ from its invoice by a cent.",
    "goal": "A refund of a whole invoice returns exactly what the invoice charged.\nPartial refunds keep rounding per line.",
    "out_of_scope": "Currency conversion.",
    "questions": [
      {
        "blocks": true,
        "pending_answer": null,
        "text": "Round half up, or to even like the ledger?"
      },
      {
        "blocks": true,
        "pending_answer": "No, only new ones.",
        "text": "Should old refunds be recomputed?"
      },
      {
        "blocks": false,
        "pending_answer": null,
        "text": "Show the rounding on the receipt?"
      }
    ],
    "source": "Support thread about a refund one cent short.",
    "what_we_know": "- Invoices round the total since 2.12.\n- `Refund#amount` sums rounded lines."
  },
